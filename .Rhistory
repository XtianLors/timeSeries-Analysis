colour = "#1B5074"),
panel.grid.minor = element_line(linewidth = 0.25, linetype = 'solid',
colour = "#1B5074"),
plot.background = element_rect(fill = "#2D3D4E")) +
stat_summary(fun=mean, geom="point", shape=16, size=4, colour="#3BC444") +
xlab("Cilindros") +
ylab("Millas por Galón") +
labs(title="BOXPLOT \n Milla por Galón vs Cilindros") +
guides(colour = guide_legend("Cilindros", legend.text=element_text("Cilindros", hjust = 0.5, vjust = 1, angle = 90)))
