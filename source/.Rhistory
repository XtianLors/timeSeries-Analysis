library("forecast")
require(zoo)
data(gas)
length(gas)
set.seed(1)
z <- zoo(11:15, as.Date(31:35))
rollapply(z, 1, mean)
rollapply(z, 2, mean)
rollapply(z, 4, mean)
z2 <- zoo(rnorm(6))
rollapply(z2, 3, mean, by = 3)
aggregate(z2, c(3,3,3,6,6,6), mean)
